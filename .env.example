# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-min-32-characters-long"
NEXTAUTH_SECRET="your-nextauth-secret-key-min-32-characters"

# Admin (used during seed - change after first deploy)
ADMIN_EMAIL="admin@oakandcode.in"
ADMIN_PASSWORD_HASH=""

# Email (Gmail SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"

# Analytics
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Site URL
NEXT_PUBLIC_SITE_URL="https://oakandcode.in"

# Cloudinary (optional - for image uploads in admin)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
